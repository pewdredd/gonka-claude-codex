# Ключи брокеров сети Gonka. Хватит одного, лучше два: если брокер лёг,
# прокси сам переключится на следующего. Пустые строки пропускаются.
# Список брокеров и их адреса - в providers.json.

# inference.dahl.global - бесплатно 100M токенов на старт
DAHL_API_KEY=

# proxy.gonka.gg - бесплатно 1M токенов на старт
GONKAGG_API_KEY=

# gonkagate.com - ключ вида gp-...
GONKA_API_KEY=

# gonka-api.org
GONKAAPI_API_KEY=

# gonkabroker.com
GONKABROKER_API_KEY=

# gonkarouter.io
GONKAROUTER_API_KEY=

# gonka24.com
GONKA24_API_KEY=
